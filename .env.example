# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty to use automatic embedded in-memory MongoDB for local dev)
MONGO_URI=

# JWT Secrets for Authentication
JWT_SECRET=gitinsight_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# GitHub REST API (Optional for unauthenticated public repo access, recommended for higher rate limits)
GITHUB_TOKEN=

# AI Provider Configuration (Google Gemini / OpenAI / Local Ollama)
# Default is Google Gemini API (Free tier available)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Vector Database (Local in-memory / Chroma / Qdrant)
VECTOR_DB_TYPE=memory
VECTOR_DB_URL=http://localhost:8000
